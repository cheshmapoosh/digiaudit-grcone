MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRCONE_MINIO_ENABLED=true
GRCONE_MINIO_ENDPOINT=http://minio:9000
GRCONE_MINIO_BUCKET=grc-documents
