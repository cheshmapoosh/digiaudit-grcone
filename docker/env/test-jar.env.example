# GRCONE portable test environment
# Used by grcone-app.bat and compose.test-jar.yml

# Docker images
JAVA_IMAGE=eclipse-temurin:21-jre-noble
ORACLE_IMAGE=gvenzl/oracle-free:23-slim
MINIO_IMAGE=minio/minio:latest

# Published ports on Windows host
APP_PORT=8080
ORACLE_PORT=1521
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Oracle test database
ORACLE_SYS_PASSWORD=oracle
DB_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1
DB_USERNAME=GRCONE
DB_PASSWORD=grcone
DB_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
DB_SCHEMA=GRCONE
FLYWAY_ENABLED=true

# MinIO test storage
MINIO_DATA_DIR=/var/lib/minio/data
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRCONE_MINIO_ENABLED=true
GRCONE_MINIO_ENDPOINT=http://minio:9000
GRCONE_MINIO_BUCKET=grc-documents
GRCONE_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
GRCONE_MINIO_ACCESS_KEY=minioadmin
GRCONE_MINIO_SECRET_KEY=minioadmin
GRCONE_MINIO_PRESIGNED_URL_EXPIRY_MINUTES=15
GRCONE_MINIO_DEFAULT_MAX_UPLOAD_SIZE_MB=25
GRCONE_MINIO_TEMP_TTL_MINUTES=120
GRCONE_MINIO_TEMPORARY_PREFIX=master-data/document/temp
GRCONE_MINIO_PERMANENT_PREFIX=master-data/document/permanent
GRCONE_MINIO_LIFECYCLE_MODE=VALIDATE
GRCONE_MINIO_TEMP_EXPIRATION_ENABLED=true
GRCONE_MINIO_TEMP_EXPIRATION_RULE_ID=grcone-temp-object-expiration
GRCONE_MINIO_TEMP_EXPIRATION_DAYS=2

# Docker volumes
ORACLE_VOLUME=grcone_test_oradata
MINIO_VOLUME=grcone_test_minio
APP_LOG_VOLUME=grcone_test_app_logs

# Java and logging
JAVA_OPTS=-Xms256m -Xmx512m
ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
