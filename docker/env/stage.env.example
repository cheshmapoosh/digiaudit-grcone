# Copy to stage.env beside compose.stage.yml and grcone-app.stage.sh.
# Replace every example credential and endpoint before running.
JAVA_IMAGE=eclipse-temurin:21-jre-noble
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
STAGE_NGINX_ENABLED=true
NGINX_IMAGE=nginx:1.28-alpine
# Set the server's IPv4 address or a DNS name. For TLS use https and APP_PORT=443.
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http
APP_PORT=8080
NGINX_TLS_DIR=./tls
# With STAGE_NGINX_ENABLED=false, HTTP and MinIO use APP_PORT and STAGE_MINIO_API_PORT.
# STAGE_MINIO_API_PORT=9000
# Set to 127.0.0.1 to bind both ports to a reverse proxy on the same host.
# STAGE_DIRECT_BIND_ADDRESS=0.0.0.0

# External Oracle. DB_SCHEMA must be the login user's own schema.
DB_URL=jdbc:oracle:thin:@//oracle-stage.example.com:1521/ORCLPDB1
DB_USERNAME=GRCONE_STAGE
DB_PASSWORD=change-me
DB_SCHEMA=GRCONE_STAGE
FLYWAY_ENABLED=true

MINIO_ROOT_USER=grcone-stage
MINIO_ROOT_PASSWORD=change-me
# The bundled proxy provides signed downloads on PUBLIC_HOST and APP_PORT.
# In direct mode, the default signed download URL uses the direct MinIO port.
# Set GRCONE_MINIO_PUBLIC_ENDPOINT only to use a separate existing MinIO gateway.
GRCONE_MINIO_BUCKET=grc-documents
GRCONE_MINIO_LIFECYCLE_MODE=VALIDATE
