# Copy to prod.env beside compose.prod.yml, then fill in real values.
JAVA_IMAGE=eclipse-temurin:21-jre-noble
APP_JAR_PATH=./grcone-app.jar
NGINX_IMAGE=nginx:1.28-alpine
PUBLIC_HOST=grc.example.com
PUBLIC_SCHEME=https
APP_PORT=443
NGINX_TLS_DIR=./tls
# For HTTP by IP use PUBLIC_HOST=<server-ip>, PUBLIC_SCHEME=http and APP_PORT=80.

DB_URL=jdbc:oracle:thin:@//oracle-host.example.com:1521/ORCLPDB1
DB_USERNAME=GRCONE
DB_PASSWORD=change-me
DB_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
DB_SCHEMA=GRCONE

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_DATA_DIR=/var/lib/minio/data
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
GRCONE_MINIO_ENABLED=true
# Optionally provision a separate MinIO application identity and set its credentials.
# GRCONE_MINIO_ACCESS_KEY=grcone-app
# GRCONE_MINIO_SECRET_KEY=change-me-app-secret
GRCONE_MINIO_BUCKET=grc-documents
GRCONE_MINIO_ENDPOINT=http://minio:9000
# The proxy provides signed downloads on PUBLIC_HOST and APP_PORT.
# Set GRCONE_MINIO_PUBLIC_ENDPOINT only to use a separate existing MinIO gateway.
GRCONE_MINIO_PRESIGNED_URL_EXPIRY_MINUTES=15
GRCONE_MINIO_DEFAULT_MAX_UPLOAD_SIZE_MB=25
GRCONE_MINIO_TEMP_TTL_MINUTES=120
GRCONE_MINIO_TEMPORARY_PREFIX=master-data/document/temp
GRCONE_MINIO_PERMANENT_PREFIX=master-data/document/permanent
GRCONE_MINIO_LIFECYCLE_MODE=APPLY
GRCONE_MINIO_TEMP_EXPIRATION_ENABLED=true
GRCONE_MINIO_TEMP_EXPIRATION_RULE_ID=grcone-temp-object-expiration
GRCONE_MINIO_TEMP_EXPIRATION_DAYS=2
MINIO_VOLUME=grcone_prod_minio

JAVA_OPTS=-Xms512m -Xmx1024m
